database -open waves -into waves.shm -default
probe -create -shm tb_uart_top.clk tb_uart_top.frame_err tb_uart_top.overrun_err tb_uart_top.parity_err tb_uart_top.rst_n tb_uart_top.rx_data tb_uart_top.rx_empty tb_uart_top.rx_full tb_uart_top.rx_ready tb_uart_top.rx_valid tb_uart_top.tx_data tb_uart_top.tx_empty tb_uart_top.tx_full tb_uart_top.tx_line tb_uart_top.tx_ready tb_uart_top.tx_valid tb_uart_top.dut.u_tx.state tb_uart_top.dut.u_tx.next_state tb_uart_top.dut.u_rx.next_state tb_uart_top.dut.u_rx.state
