database -open waves -into waves.shm -default
probe -create -shm tb_uart_rx.clk tb_uart_rx.rst_n tb_uart_rx.os_tick tb_uart_rx.baud_tick tb_uart_rx.data tb_uart_rx.u_rx.bit_cnt tb_uart_rx.rx tb_uart_rx.rx_valid tb_uart_rx.rx_ready tb_uart_rx.rx_full tb_uart_rx.rx_empty tb_uart_rx.rx_data tb_uart_rx.u_rx.expected_parity tb_uart_rx.u_rx.rx_parity_bit tb_uart_rx.parity_err tb_uart_rx.frame_err tb_uart_rx.overrun_err tb_uart_rx.u_rx.state tb_uart_rx.u_rx.next_state
run
scope -set tb_uart_rx.u_rx
scope -set tb_uart_rx
exit
