database -open waves -into waves.shm -default
probe -create -shm tb_uart_tx.baud_cnt tb_uart_tx.baud_tick tb_uart_tx.bit_i tb_uart_tx.clk tb_uart_tx.errors tb_uart_tx.i tb_uart_tx.rst_n tb_uart_tx.rx_data tb_uart_tx.rx_parity tb_uart_tx.rx_stop tb_uart_tx.tx tb_uart_tx.tx_data tb_uart_tx.tx_empty tb_uart_tx.tx_full tb_uart_tx.tx_ready tb_uart_tx.tx_valid
run
